{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=events;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Lifetime": 15,
    "Issuer": "Issuer",
    "Audience": "Audience",
    "Key": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "MessageBroker": {
    "BootstrapServers": "localhost:9092",
    "MessageTypeHeaderName": "message-type",
    "ConsumerGroup": "event-processing"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379
  },
  "Cache": {
    "Top10TTL": 30,
    "RegularTTL": 5
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318/v1/traces",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
