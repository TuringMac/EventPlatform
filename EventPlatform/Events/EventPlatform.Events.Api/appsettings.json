{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=events;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Lifetime": 15,
    "Issuer": "Issuer",
    "Audience": "Audience",
    "Key": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "MessageBroker": {
    "BootstrapServers": "localhost:9092",
    "MessageTypeHeaderName": "message-type",
    "ConsumerGroup": "event-processing"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379
  },
  "Cache": {
    "Top10TTL": 30,
    "RegularTTL": 5
  }
}
